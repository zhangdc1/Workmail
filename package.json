{
  "name": "inboxlab-next",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --env-file=.env apps/api/src/server.ts",
    "dev:web": "vite --config apps/web/vite.config.ts --host 127.0.0.1",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "db:bootstrap": "tsx --env-file=.env scripts/bootstrap.ts",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "storage:report": "tsx --env-file=.env scripts/storage-maintenance.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build --config apps/web/vite.config.ts && tsc -p tsconfig.server.json && node scripts/postbuild.mjs",
    "start": "node --env-file=.env dist/apps/api/src/server.js",
    "worker": "tsx --env-file=.env apps/api/src/worker.ts",
    "smtp": "tsx --env-file=.env apps/api/src/smtp.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "extension:build": "node scripts/build-extensions.mjs",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@fastify/cookie": "^11.1.3",
    "@fastify/multipart": "^10.1.4",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@fastify/type-provider-typebox": "^6.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@sinclair/typebox": "^0.34.52",
    "@tanstack/react-query": "^5.104.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.7",
    "lucide-react": "^1.59.0",
    "pg": "^8.23.1",
    "postal-mime": "^4.0.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "sanitize-html": "^2.18.1",
    "smtp-server": "^3.19.23",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@types/smtp-server": "^3.5.13",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
