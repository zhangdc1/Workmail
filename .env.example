NODE_ENV=development
HOST=127.0.0.1
PORT=3001
PUBLIC_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://inboxlab:local-development-only@127.0.0.1:5432/inboxlab
DATABASE_MODE=postgres
DATA_DIR=./data/mail
ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
BOOTSTRAP_USERNAME=admin
BOOTSTRAP_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD
SMTP_HOST=127.0.0.1
SMTP_PORT=2525
SMTP_MAX_BYTES=10485760
MAIL_HOSTNAME=mx.example.com
SESSION_HOURS=24
ALLOW_PRIVATE_PROXY=false
TRUST_PROXY_CIDRS=
INTEGRATION_PYTHON=python3
# Optional: enables a disk-backed PostgreSQL/WASM engine for local development.
# DATABASE_MODE=pglite
# PGLITE_DIR=./data/pglite
